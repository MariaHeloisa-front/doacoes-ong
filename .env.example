# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Nunca coloque a chave service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional — usados só por `npm run verificar:rls` para conferir um usuário da equipe
# (nunca são enviados ao navegador, pois não começam com VITE_).
VERIFICAR_EMAIL=
VERIFICAR_SENHA=
